def calculate_abjad_value(name):
    abjad_values = {
        'ا': 1, 'ب': 2, 'ج': 3, 'د': 4, 'ه': 5, 'و': 6, 'ز': 7, 'ح': 8, 'ط': 9,
        'ی': 10, 'ک': 20, 'ل': 30, 'م': 40, 'ن': 50, 'س': 60, 'ع': 70, 'ف': 80,
        'ص': 90, 'ق': 100, 'ر': 200, 'ش': 300, 'ت': 400, 'ث': 500, 'خ': 600,
        'ذ': 700, 'ض': 800, 'ظ': 900, 'غ': 1000
    }
    
    total_value = 0
    for char in name:
        total_value += abjad_values.get(char, 0)
    return total_value

def calculate_life_path_number(date_of_birth):
    date_numbers = date_of_birth.replace('/', '')
    while len(date_numbers) > 1:
        date_numbers = str(sum(int(digit) for digit in date_numbers))
    return int(date_numbers)

def calculate_human_code(name, mother_name, date_of_birth):
    name_value = calculate_abjad_value(name)
    mother_name_value = calculate_abjad_value(mother_name)
    life_path_number = calculate_life_path_number(date_of_birth)
    
    human_code = name_value + mother_name_value + life_path_number
    return human_code

# مثال استفاده از برنامه:
name = 'احمد'
mother_name = 'فاطمه'
date_of_birth = '1367/06/11'

human_code = calculate_human_code(name, mother_name, date_of_birth)
print(f'کد انسانی: {human_code}')
